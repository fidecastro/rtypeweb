# libSQL / Turso connection (required for production on Vercel)
# Local default (when unset): file:./data/rtype.db relative to lib/
# LIBSQL_URL=libsql://your-db-name-org.turso.io
# LIBSQL_AUTH_TOKEN=
#
# Production: use the SAME LIBSQL_URL / LIBSQL_AUTH_TOKEN as the web games portal
# so portal-authenticated players exist in this game's players table for score submit.
# Client portal handoff uses ?portalBase= / localStorage rtypeweb.portalBase (not a server env).

# Optional: local API / smoke test
# PORT=3000
# API_BASE=http://localhost:3000
